# Copy to .env (or export in your shell / hosting dashboard). Never commit real values.
PORT=3000
NODE_ENV=development
# Admin account seeded on first start. If ADMIN_PASSWORD is empty a random one is printed once.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# NASA FIRMS MAP_KEY (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without it the app shows "fire detections not configured" and never invents detections.
FIRMS_MAP_KEY=
DB_FILE=./firewatch.db
